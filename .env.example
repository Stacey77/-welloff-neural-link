# WellOff MCP gateway — all agent tool calls route through this
WELLOFF_MCP_URL=http://localhost:3000/api/mcp

# Anthropic — used only by TON orchestrator for natural-language routing
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=3001

# LLM providers (add any; MAESTRO routes between the ones configured)
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# LLM_POLICY=balanced   # quality | balanced | economy | speed

# LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=neural-link

# Lindy.ai
LINDY_WEBHOOK_URL=
LINDY_WEBHOOK_SECRET=
LINDY_INBOUND_SECRET=

# Security
NL_PROTECTED_DOMAINS=          # your domains, comma separated (lookalike detection)
# NL_RETENTION_DAYS=365
# NL_DNS_SERVERS=1.1.1.1,8.8.8.8

# EVE assistant inbound events (Zapier, Make, Lindy, Calendly)
ASSISTANT_WEBHOOK_SECRET=

# Jobs webhook (other systems hand TON a job)
JOBS_WEBHOOK_SECRET=
